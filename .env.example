# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# prod.py refuses to start with a placeholder or a key shorter than 50 characters.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production / staging only (config.settings.prod)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.sharebucketlist.com
# SITE_URL=https://staging.sharebucketlist.com
# SECURE_HSTS_SECONDS=31536000   # a year (the default); use 3600 while trying HTTPS on a new domain
# DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=travel_site
POSTGRES_USER=traveluser
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Outgoing mail (any SMTP provider). Production requires EMAIL_HOST.
#   Authenticated relay, STARTTLS:  EMAIL_PORT=587 EMAIL_USE_TLS=True  EMAIL_USE_SSL=False
#   Implicit TLS:                   EMAIL_PORT=465 EMAIL_USE_TLS=False EMAIL_USE_SSL=True
#   Local relay (postfix etc.):     EMAIL_HOST=localhost EMAIL_PORT=25 EMAIL_USE_TLS=False, no user/password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@sharebucketlist.com   # must be a sender your provider accepts
# Error emails (production): who gets them, comma-separated; empty = none. SERVER_EMAIL is
# their sender (defaults to DEFAULT_FROM_EMAIL, so your provider must accept it).
# DJANGO_ADMINS also receives every script's and scheduled job's reports (backups, syncs, cron jobs).
# DJANGO_ADMINS=James <you@example.com>
# SERVER_EMAIL=alerts@sharebucketlist.com

# Terms / Privacy / Safety pages (apps/pages). While any is unset the pages show a "draft" banner.
# LEGAL_ENTITY_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_POSTAL_ADDRESS=
# LEGAL_JURISDICTION=
# LEGAL_EFFECTIVE_DATE=
# LEGAL_MIN_AGE=16

# Maps: "osm" (OpenStreetMap, no key needed). Tile URL / attribution only if you change tile server.
MAP_PROVIDER=osm
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GOOGLE_MAPS_API_KEY=

# REST Countries key for the monthly `manage.py check_countries` report (sent as a Bearer header, never stored).
RESTCOUNTRIES_API_KEY=

# Who may register: "invite" (default: a trip invite link or a sign-up code from the admin) or "open".
# SIGNUP_MODE=invite
