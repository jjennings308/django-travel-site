# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# prod.py refuses to start with a placeholder or a key shorter than 50 characters.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production / staging only (config.settings.prod)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.sharebucketlist.com
# SITE_URL=https://staging.sharebucketlist.com
# SECURE_HSTS_SECONDS=3600
# DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=travel_site
POSTGRES_USER=traveluser
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SMTP (smtp2go) — EMAIL_HOST/PORT/USE_TLS default to smtp2go on 587 with TLS
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
